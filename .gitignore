# Local secrets; keep shareable environment templates
.env
.env.*
!.env.example
!.env.sample
!.env.template
.aws/
.ssh/

# Local editor and coding-agent state
.idea/
.vscode/
.codex/
.agents/
.ipynb_checkpoints/
*.swp
*.swo
*~

